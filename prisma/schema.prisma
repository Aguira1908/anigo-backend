// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

  // output   = "../src/generated/prisma"
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AnimeStatus {
  ON_GOING
  COMPLETED
  UPCOMING
  PENDING
}

// Prisma Enum tidak boleh diawali angka (misal '320p' jadi P320)
enum Resolution {
  P320
  P480
  P720
}

model User {
  id            String         @id @default(uuid(7)) // UUID v7 bawaan Prisma terbaru
  username      String         @unique
  password      String         // Hash bcrypt akan disimpan di sini
  role          String         @default("USER")
  createdAt     DateTime       @default(now())

  @@map("users")
}

model Anime {
  id            String      @id @default(uuid(7))
  title         String
  titleJapan    String?     // Pakai ? (opsional) karena mungkin tidak semua anime ada judul jepangnya
  slug          String      @unique
  type          String?
  coverImage    String?
  status        AnimeStatus @default(ON_GOING)
  studio        String?
  totalEpisodes Int?
  releaseDate   DateTime?   @db.Date
  rating        Float?
  synopsis      String?     @db.Text
  url           String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relasi
  genres        Genre[]     // Relasi Many-to-Many (1 Anime punya banyak Genre, 1 Genre punya banyak Anime)
  episodes      Episode[]

  @@map("animes")
}

model Genre {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi Many-to-Many ke Anime
  animes    Anime[]

  @@map("genres")
}

model Episode {
  id            String    @id @default(uuid(7))
  animeId       String
  slug          String    @unique
  title         String?
  episodeNumber Int
  mirrorLink    String?
  urlEpisode    String?
  releaseDate   DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relasi
  anime         Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  mirrors       Mirror[]

  @@map("episodes")
}

model Mirror {
  id         String         @id @default(uuid(7))
  episodeId  String
  resolution Resolution
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Relasi
  episode    Episode        @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  servers    StreamServer[]

  @@unique([episodeId, resolution])
  @@map("mirrors")
}

model StreamServer {
  id          String   @id @default(uuid(7))
  mirrorId    String
  platform    String   @db.VarChar(100)
  dataContent String?  @db.Text
  embedUrl    String?  @db.Text
  embedHtml   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi
  mirror      Mirror   @relation(fields: [mirrorId], references: [id], onDelete: Cascade)

  @@unique([mirrorId, platform])
  @@map("stream_servers")
}